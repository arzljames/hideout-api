{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run contracts:*)",
      "Bash(npx supabase start)",
      "Bash(npx supabase status)",
      "Bash(npx supabase db reset)",
      "Bash(npx supabase test db)",
      "Bash(npx supabase migration new:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  }
}