# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Proxy hops in front of the API (0 = none). Required in production; wrong values let clients spoof req.ip.
TRUST_PROXY=0

# Public URLs. Web and API must be same-site (see CLAUDE.md "Deployment topology").
# Local dev: hideout-web's Vite proxy forwards /api to :3001, so both are the Vite origin.
API_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Supabase dev project: Dashboard -> Project Settings -> Data API / API Keys. Service role key is server-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign the short-lived Realtime JWT (Dashboard -> JWT Keys -> legacy JWT secret; min 32 chars).
SUPABASE_JWT_SECRET=

# Tooling only: npm run db:* and test:db (the app never reads these).
# SECRET: contains the database password. Never paste it into issues, logs, or chat.
# Dashboard -> Connect -> Session pooler. Percent-encode special characters in the password.
SUPABASE_DB_URL=
# The dev project ref (the <ref> in https://<ref>.supabase.co). db scripts refuse any other project.
SUPABASE_DEV_PROJECT_REF=
# Optional: path to the Supabase root CA (Dashboard -> Database -> SSL Configuration) for verified TLS in test:db.
SUPABASE_DB_CA_CERT=

# HMAC key for stored session token hashes (min 32 chars, different from SUPABASE_JWT_SECRET). Rotating it signs everyone out.
SESSION_SECRET=

# Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
