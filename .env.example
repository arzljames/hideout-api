# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Proxy hops in front of the API (0 = none). Required in production; wrong values let clients spoof req.ip.
TRUST_PROXY=0

# Public URLs. Web and API must be same-site (see CLAUDE.md "Deployment topology").
# Local dev: hideout-web's Vite proxy forwards /api to :3001, so both are the Vite origin.
API_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Supabase (from `npx supabase status` locally). Service role key is server-only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign the short-lived Realtime JWT (legacy JWT secret; min 32 chars).
SUPABASE_JWT_SECRET=

# Signs the session cookie (min 32 chars, different from SUPABASE_JWT_SECRET).
SESSION_SECRET=

# Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
