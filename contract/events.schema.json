{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Realtime contract for hideout-web. Generated from src/contracts/events.ts; do not edit.",
  "version": "0.1.0",
  "topics": {
    "room": {
      "pattern": "room:<roomId>",
      "private": true,
      "clientsMay": {
        "broadcast": false,
        "presence": true
      },
      "presence": {
        "$ref": "#/$defs/RoomPresence"
      }
    },
    "channel": {
      "pattern": "channel:<channelId>",
      "private": true,
      "clientsMay": {
        "broadcast": false,
        "presence": false
      }
    },
    "typing": {
      "pattern": "typing:<channelId>",
      "private": true,
      "clientsMay": {
        "broadcast": true,
        "presence": false
      }
    },
    "user": {
      "pattern": "user:<profileId>",
      "private": true,
      "clientsMay": {
        "broadcast": false,
        "presence": false
      }
    }
  },
  "serverEvents": {
    "channel": {
      "message:created": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/$defs/Message"
          }
        },
        "required": [
          "message"
        ]
      },
      "message:updated": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/$defs/Message"
          }
        },
        "required": [
          "message"
        ]
      },
      "message:deleted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "channelId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "id",
          "channelId"
        ]
      }
    },
    "room": {
      "channel:created": {
        "type": "object",
        "properties": {
          "channel": {
            "$ref": "#/$defs/Channel"
          }
        },
        "required": [
          "channel"
        ]
      },
      "channel:updated": {
        "type": "object",
        "properties": {
          "channel": {
            "$ref": "#/$defs/Channel"
          }
        },
        "required": [
          "channel"
        ]
      },
      "channel:deleted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "roomId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "id",
          "roomId"
        ]
      },
      "channel:reordered": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice"
            ]
          },
          "channelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
            }
          }
        },
        "required": [
          "roomId",
          "type",
          "channelIds"
        ]
      },
      "member:joined": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/$defs/Member"
          }
        },
        "required": [
          "member"
        ]
      },
      "member:left": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "roomId",
          "userId"
        ]
      },
      "member:role_changed": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "role": {
            "$ref": "#/$defs/Role"
          }
        },
        "required": [
          "roomId",
          "userId",
          "role"
        ]
      },
      "voice:participants": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ProfileSummary"
            }
          }
        },
        "required": [
          "channelId",
          "participants"
        ]
      },
      "room:updated": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/$defs/Room"
          }
        },
        "required": [
          "room"
        ]
      },
      "room:deleted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "user": {
      "invite:received": {
        "type": "object",
        "properties": {
          "inviteId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "room": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "$ref": "#/$defs/RoomIcon"
              }
            },
            "required": [
              "id",
              "name",
              "icon"
            ]
          },
          "invitedBy": {
            "$ref": "#/$defs/ProfileSummary"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "inviteId",
          "room",
          "invitedBy",
          "expiresAt"
        ]
      },
      "invite:revoked": {
        "type": "object",
        "properties": {
          "inviteId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "inviteId"
        ]
      },
      "member:removed": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "roomId"
        ]
      },
      "session:expired": {
        "type": "object",
        "properties": {}
      }
    }
  },
  "clientEvents": {
    "typing": {
      "typing": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "userId"
        ]
      }
    }
  },
  "$defs": {
    "ProfileSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "displayName": {
          "type": "string"
        },
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "displayName",
        "avatarUrl"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "member"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "channelId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "editedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "channelId",
        "author",
        "body",
        "createdAt",
        "editedAt"
      ]
    },
    "Channel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "roomId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "voice"
          ]
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "roomId",
        "type",
        "name",
        "position"
      ]
    },
    "RoomIcon": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "emoji"
            },
            "emoji": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "emoji"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        }
      ]
    },
    "Room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "name": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/RoomIcon"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "id",
        "name",
        "icon",
        "createdAt"
      ]
    },
    "Member": {
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "user": {
          "$ref": "#/$defs/ProfileSummary"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "currentGame": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "roomId",
        "user",
        "role",
        "joinedAt",
        "currentGame"
      ]
    },
    "RoomPresence": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        }
      },
      "required": [
        "userId"
      ]
    }
  }
}
