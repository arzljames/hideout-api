{
  "openapi": "3.1.0",
  "info": {
    "title": "hideout-api",
    "version": "0.1.0",
    "description": "REST contract for hideout-web. Generated from src/contracts/http; do not edit."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hideout_session",
        "description": "httpOnly session cookie, named __Host-hideout_session over HTTPS."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_FAILED",
                "description": "One of: BAD_REQUEST, INVALID_JSON, UNAUTHENTICATED, FORBIDDEN, ORIGIN_NOT_ALLOWED, UNSUPPORTED_CONTENT_TYPE, NOT_FOUND, CONFLICT, PAYLOAD_TOO_LARGE, VALIDATION_FAILED, RATE_LIMITED, INTERNAL."
              },
              "message": {
                "type": "string",
                "example": "This invite has expired."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                },
                "description": "Present on 422 validation errors."
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "AuthRedirectError": {
        "type": "string",
        "enum": [
          "STEAM_LOGIN_FAILED",
          "LOGIN_STATE_MISMATCH",
          "STEAM_UNAVAILABLE",
          "LOGIN_FAILED",
          "RATE_LIMITED"
        ],
        "description": "Value of the `auth_error` query param when the Steam callback redirects back to WEB_ORIGIN. STEAM_LOGIN_FAILED: Steam rejected or we could not verify the sign-in. LOGIN_STATE_MISMATCH: the sign-in was not started from this browser (or took over 10 minutes). STEAM_UNAVAILABLE: Steam could not be reached. LOGIN_FAILED: our server failed to create the session. RATE_LIMITED: too many sign-in attempts from this network; try again in a minute."
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "steamId": {
            "type": "string",
            "pattern": "^[0-9]{17}$",
            "example": "76561197960287930"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "Gordon"
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "id",
          "steamId",
          "displayName",
          "avatarUrl"
        ]
      },
      "RealtimeToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Supabase JWT for `supabase.realtime.setAuth(token)`."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-25T10:15:00.000Z",
            "description": "When the token expires. Refresh about a minute before."
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "ProfileSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "id",
          "displayName",
          "avatarUrl"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "member"
        ]
      },
      "RoomIcon": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "emoji"
                ]
              },
              "emoji": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "emoji"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "image"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "kind",
              "url"
            ]
          }
        ]
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice"
            ]
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "roomId",
          "type",
          "name",
          "position"
        ]
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "$ref": "#/components/schemas/RoomIcon"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "createdAt"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "user": {
            "$ref": "#/components/schemas/ProfileSummary"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentGame": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "roomId",
          "user",
          "role",
          "joinedAt",
          "currentGame"
        ]
      },
      "RoomName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "description": "Room name: 1–48 UTF-16 code units after trimming surrounding whitespace. Must contain at least one letter, number, symbol, or punctuation mark, and no invisible or bidi control characters (control characters, U+200B, U+200C, U+200E, U+200F, U+202A–U+202E, U+2060–U+2064, U+2066–U+2069, U+FEFF; U+200D zero-width joiner is allowed for emoji).",
        "example": "Friday Night Raids"
      },
      "RoomIconInput": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "emoji"
                ]
              },
              "emoji": {
                "type": "string",
                "maxLength": 16,
                "description": "Exactly one emoji (RGI emoji sequence, at most 16 UTF-16 code units).",
                "example": "🎮"
              }
            },
            "required": [
              "kind",
              "emoji"
            ],
            "additionalProperties": false
          }
        ],
        "description": "The room icon to set. Only `emoji` is accepted today; more kinds may be added later."
      },
      "CreateRoomBody": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/RoomName"
          },
          "icon": {
            "$ref": "#/components/schemas/RoomIconInput"
          }
        },
        "required": [
          "name",
          "icon"
        ],
        "additionalProperties": false
      },
      "UpdateRoomBody": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/RoomName"
          },
          "icon": {
            "$ref": "#/components/schemas/RoomIconInput"
          }
        },
        "additionalProperties": false,
        "description": "At least one of `name` or `icon` is required.",
        "minProperties": 1
      },
      "MyRoom": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "myRole": {
            "$ref": "#/components/schemas/Role"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "room",
          "myRole",
          "joinedAt"
        ]
      },
      "MyRoomPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyRoom"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "RoomDetail": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "myRole": {
            "$ref": "#/components/schemas/Role"
          },
          "defaultChannelId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Lowest-position text channel (where \"You'll land in #general\" points); null if there is none."
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Channel"
            },
            "description": "Live channels: text first, then voice, each by position."
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "description": "All members: owner, then admins, then members, each by name."
          }
        },
        "required": [
          "room",
          "myRole",
          "defaultChannelId",
          "channels",
          "members"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "security": [],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "security": [],
        "summary": "Readiness probe (database, Realtime, LiveKit reachable)",
        "responses": {
          "200": {
            "description": "All dependencies reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/contract/openapi.json": {
      "get": {
        "tags": [
          "contract"
        ],
        "security": [],
        "summary": "This REST contract",
        "responses": {
          "200": {
            "description": "OpenAPI document."
          },
          "404": {
            "description": "Not generated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/contract/events.schema.json": {
      "get": {
        "tags": [
          "contract"
        ],
        "security": [],
        "summary": "The realtime event contract",
        "responses": {
          "200": {
            "description": "JSON Schema document."
          },
          "404": {
            "description": "Not generated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/docs": {
      "get": {
        "tags": [
          "contract"
        ],
        "security": [],
        "summary": "Swagger UI for this REST contract",
        "responses": {
          "200": {
            "description": "HTML page.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/steam": {
      "get": {
        "tags": [
          "auth"
        ],
        "security": [],
        "summary": "Start Steam sign-in",
        "description": "Navigate the browser here (a full page load, not fetch). Sets a short-lived state cookie and redirects to Steam. Steam then sends the browser to /api/auth/steam/callback.",
        "responses": {
          "302": {
            "description": "Redirect to the Steam sign-in page, or to WEB_ORIGIN/?auth_error=RATE_LIMITED when rate limited.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "description": "Redirect target."
                },
                "required": true,
                "description": "Redirect target."
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "description": "httpOnly login state cookie (10 minutes)."
                },
                "required": true,
                "description": "httpOnly login state cookie (10 minutes)."
              }
            }
          }
        }
      }
    },
    "/api/auth/steam/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "security": [],
        "summary": "Steam sign-in callback",
        "description": "Steam redirects the browser here; clients never call it directly. On success it sets the session cookie and redirects to WEB_ORIGIN/. On failure it redirects to WEB_ORIGIN/?auth_error=<code>; see the AuthRedirectError schema for the codes.",
        "responses": {
          "302": {
            "description": "Redirect back to hideout-web: WEB_ORIGIN/ on success, WEB_ORIGIN/?auth_error=<AuthRedirectError> on failure.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "description": "Redirect target."
                },
                "required": true,
                "description": "Redirect target."
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "description": "Clears the login state cookie; on success also sets the httpOnly session cookie (7 days)."
                },
                "required": true,
                "description": "Clears the login state cookie; on success also sets the httpOnly session cookie (7 days)."
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out of this device",
        "description": "Deletes the current session and clears the cookie. Send `Content-Type: application/json` (no body needed) with credentials; the CSRF check requires it.",
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origin or Content-Type check failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout-all": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out of every device",
        "description": "Deletes all of the current user’s sessions and clears the cookie. Same request rules as logout. Afterwards the API broadcasts `session:expired` (empty payload) on the user’s `user:<profileId>` Realtime topic so other open tabs and devices can sign out; delivery is best-effort and never fails this request. Single-device logout does not broadcast.",
        "responses": {
          "204": {
            "description": "Signed out everywhere."
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origin or Content-Type check failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user",
        "description": "The signed-in user’s own profile. Call on load with credentials: 200 means signed in, 401 means signed out. Sent with `Cache-Control: no-store`.",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/realtime-token": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Realtime token",
        "description": "A short-lived (15 minute) Supabase JWT for joining private Realtime channels. Call `supabase.realtime.setAuth(token)` and fetch a new one about a minute before `expiresAt`. The token carries no room claims: which topics can be joined is decided by current room membership. Sent with `Cache-Control: no-store`. Rate limited to 30 requests per hour per user.",
        "responses": {
          "200": {
            "description": "A fresh Realtime token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeToken"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "tags": [
          "rooms"
        ],
        "summary": "Create a room",
        "description": "Creates a room owned by the caller, with a `general` text channel and a `voice` voice channel. Not idempotent: disable the create button while the request is pending. Rate limited to 10/hour per user. Writes need `Content-Type: application/json` (even with no body) and credentials; the CSRF check requires it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new room.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomDetail"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origin or Content-Type check failed (send `Content-Type: application/json` from WEB_ORIGIN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid name or icon.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "List my rooms",
        "description": "Rooms the caller belongs to, oldest membership first. Cursor-paginated: pass `nextCursor` back as `cursor` until it is null. Sent with `Cache-Control: no-store`.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of rooms.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyRoomPage"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid cursor or limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
