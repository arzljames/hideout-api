{
  "name": "hideout-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Hideout: invite-only voice and text rooms for Steam players",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts | pino-pretty",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts": "tsx scripts/generate-contracts.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arzljames/hideout-api.git"
  },
  "bugs": {
    "url": "https://github.com/arzljames/hideout-api/issues"
  },
  "homepage": "https://github.com/arzljames/hideout-api#readme",
  "license": "UNLICENSED",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@supabase/supabase-js": "^2.117.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "supabase": "^2.117.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
